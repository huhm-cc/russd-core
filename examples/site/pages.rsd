fn fizz_cell(n: i32) -> str {
    if n % 15 == 0 {
        return "<span class=\"mono\">FizzBuzz</span>"
    }
    if n % 3 == 0 {
        return "<span class=\"mono\">Fizz</span>"
    }
    if n % 5 == 0 {
        return "<span class=\"mono\">Buzz</span>"
    }
    "" + n
}

fn fizz_table() -> str {
    let mut rows = ""
    let mut n = 1
    while n <= 30 {
        rows = rows.clone() + "<tr><th>" + n + "</th><td>" + fizz_cell(n) + "</td></tr>"
        n += 1
    }
    "<table><thead><tr><th>n</th><th>值</th></tr></thead><tbody>" + rows + "</tbody></table>"
}

fn page_home(query: str) -> str {
    let name = form_get(query, "name")
    let mut hello = "<p>沒帶名字也沒關係，在網址加 <code>/?name=Ada</code> 會換成招呼。</p>"
    if name.clone() != "" {
        hello = "<p>你好，<strong>" + escape(name) + "</strong>。這段字是路由讀 query 之後印出來的。</p>"
    }
    layout(
        "木質工作臺",
        "<article><h2>這是一個用 Russd 寫的網站</h2>"
            + hello
            + "<div class=\"grid two\"><section><h2>頁面</h2><ul><li>首頁：query 字串</li><li>FizzBuzz：迴圈在伺服器算好再輸出 HTML</li><li>留言板：POST 表單寫進工作目錄檔案</li><li>狀態：命中次數與 <code>now_ms</code></li><li><code>/api/stats</code>：JSON（仍是 str 拼出來的）</li></ul></section><section><h2>刻意沒有</h2><ul><li>沒有 TLS、沒有 cookie、沒有資料庫</li><li>只聽 127.0.0.1</li><li>留言最多 12 則、每則 160 字</li></ul></section></div></article>",
    )
}

fn page_fizz() -> str {
    layout(
        "FizzBuzz",
        "<article><h2>在 VM 裡算的 FizzBuzz</h2><p>1 到 30，規則寫在 <code>pages.rsd</code> 的 <code>fizz_cell</code>。</p>"
            + fizz_table()
            + "</article>",
    )
}

fn page_board(flash: str) -> str {
    let notes = load_notes()
    let mut list = "<p>還沒有留言。當第一個。</p>"
    if notes.len() > 0 {
        list = "<ul>"
        for line in notes {
            let t = line.clone()
            let m = line.clone()
            list = list.clone()
                + "<li><strong>"
                + escape(note_name(line))
                + "</strong> <span class=\"mono\">#"
                + escape(note_time(t))
                + "</span><br>"
                + escape(note_msg(m))
                + "</li>"
        }
        list = list.clone() + "</ul>"
    }
    let mut banner = ""
    if flash.clone() == "ok" {
        banner = "<p>已寫入工作目錄的 <code>russd-board-notes.txt</code>。</p>"
    } else {
        if flash.clone() != "" {
            banner = "<p>" + escape(flash) + "</p>"
        }
    }
    layout(
        "留言板",
        "<article><h2>留言板</h2>"
            + banner
            + "<form method=\"post\" action=\"/board\"><label>名字</label><input name=\"name\" maxlength=\"24\" required><label>一句話</label><textarea name=\"msg\" rows=\"3\" maxlength=\"160\" required></textarea><button type=\"submit\">張貼</button></form>"
            + list
            + "</article>",
    )
}

fn page_status() -> str {
    let hits = read_hits()
    let notes = load_notes()
    let ms = now_ms()
    layout(
        "狀態",
        "<article><h2>執行期狀態</h2><p>這些數字來自這次 VM 行程，重開伺服器檔案還在。</p><ul><li>命中次數（含本次）：<span class=\"mono\">"
            + hits
            + "</span></li><li>留言則數：<span class=\"mono\">"
            + notes.len()
            + "</span></li><li><code>now_ms</code>：<span class=\"mono\">"
            + ms
            + "</span></li></ul></article>",
    )
}

fn page_not_found(path: str) -> str {
    layout(
        "沒有這個路徑",
        "<article><h2>沒有 "
            + escape(path)
            + "</h2><p>路由器只認識 <code>/</code> <code>/fizz</code> <code>/board</code> <code>/status</code> <code>/api/stats</code>。</p></article>",
    )
}

fn json_stats() -> str {
    let hits = read_hits()
    let notes = load_notes()
    let ms = now_ms()
    "{\"site\":\"russd-workshop\",\"hits\":"
        + hits
        + ",\"notes\":"
        + notes.len()
        + ",\"now_ms\":"
        + ms
        + "}"
}

fn on_request(method: str, path: str, query: str, body: str) -> str {
    bump_hits()
    if path.clone() == "/api/stats" {
        return json_stats()
    }
    if path.clone() == "/" {
        return page_home(query)
    }
    if path.clone() == "/fizz" {
        return page_fizz()
    }
    if path.clone() == "/status" {
        return page_status()
    }
    if path.clone() == "/board" {
        if method.clone() == "POST" {
            let body2 = body.clone()
            let name = form_get(body, "name")
            let msg = form_get(body2, "msg")
            let flash = add_note(name, msg)
            return page_board(flash)
        }
        return page_board("")
    }
    page_not_found(path)
}
